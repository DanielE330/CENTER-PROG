# Generated by deploy/gen.py from deploy/services.yaml. Do not edit by hand.
[Unit]
Description=ci1 cert-advisor
Requires=ci1-step-ca.service
After=ci1-step-ca.service

[Container]
ContainerName=cert-advisor
Image=docker.io/smallstep/step-cli:0.31.0
User=10001:10001
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
Tmpfs=/tmp:size=64m
Volume=ci1-certs-advisor.volume:/certs
Volume=ci1-ca-public.volume:/ca-public:ro
Volume=%h/ci1/deploy/scripts:/agent:ro
Network=ci1-app.network
Environment=NAME=advisor
Environment=LIFETIME=168h
Environment=PKCS8=false
Secret=provisioner_password,type=mount,uid=10001,mode=0400
PodmanArgs=--entrypoint=/bin/sh
Exec=/agent/cert-agent.sh
HealthCmd=test -s /certs/cert.pem
HealthInterval=3s
PodmanArgs=--memory=32m

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
