# Generated by deploy/gen.py from deploy/services.yaml. Do not edit by hand.
[Unit]
Description=ci1 connectors
Requires=ci1-cert-connectors.service
After=ci1-cert-connectors.service
Requires=ci1-nats.service
After=ci1-nats.service
Requires=ci1-keycloak.service
After=ci1-keycloak.service

[Container]
ContainerName=connectors
Image=ghcr.io/swimshadow/ci1-connectors:stable
User=10001:10001
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
Tmpfs=/tmp:size=64m
Volume=ci1-certs-connectors.volume:/certs:ro
Volume=%h/ci1/data:-../../data}:/data:ro
Network=ci1-app.network
Network=ci1-data.network
Network=ci1-egress.network
Environment=SERVICE_NAME=connectors
Environment=LISTEN_ADDR=0.0.0.0:8443
Environment=CERT_DIR=/certs
Environment=ALLOWED_CLIENTS=gateway
Environment=OIDC_ISSUER=https://ci1.local:8443/auth/realms/ci1
Environment=OIDC_JWKS_URL=https://keycloak:8443/auth/realms/ci1/protocol/openid-connect/certs
Environment=OIDC_AUDIENCE=ci1-api
Environment=KEYCLOAK_INTERNAL_URL=https://keycloak:8443/auth
Environment=NATS_URL=tls://nats:4222
Environment=RUST_LOG=info
Environment=DATA_DIR=/data
Secret=counterparty_hmac_key,type=mount,uid=10001,mode=0400
Secret=demo_password,type=mount,uid=10001,mode=0400
HealthCmd=/venv/bin/python -m connectors --healthcheck
HealthInterval=10s
PodmanArgs=--memory=256m

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
