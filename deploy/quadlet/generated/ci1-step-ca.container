# Generated by deploy/gen.py from deploy/services.yaml. Do not edit by hand.
[Unit]
Description=ci1 step-ca

[Container]
ContainerName=step-ca
Image=docker.io/smallstep/step-ca:0.30.2
User=1000:1000
ReadOnly=true
DropCapability=all
AddCapability=NET_BIND_SERVICE
Tmpfs=/tmp:size=64m
Volume=ci1-stepca.volume:/home/step
Volume=ci1-ca-public.volume:/ca-public
Volume=%h/ci1/deploy/scripts:/agent:ro
Network=ci1-app.network
Environment=MAX_LIFETIME=168h
Secret=provisioner_password,type=mount,uid=1000,mode=0400
PodmanArgs=--entrypoint=/bin/sh
Exec=/agent/step-ca.sh
PodmanArgs=--memory=64m

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
