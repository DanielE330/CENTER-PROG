# Generated by deploy/gen.py from deploy/services.yaml. Do not edit by hand.
[Unit]
Description=ci1 keycloak
Requires=ci1-cert-keycloak.service
After=ci1-cert-keycloak.service
Requires=ci1-postgres.service
After=ci1-postgres.service

[Container]
ContainerName=keycloak
Image=quay.io/keycloak/keycloak:26.7.5
User=1000:1000
DropCapability=all
NoNewPrivileges=true
Tmpfs=/tmp:size=64m
Volume=ci1-certs-keycloak.volume:/certs:ro
Volume=%h/ci1/deploy/keycloak:/realm:ro
Volume=ci1-kcdata.volume:/opt/keycloak/data
Network=ci1-app.network
Network=ci1-data.network
Environment=KC_DB=postgres
Environment=KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak?ssl=true&sslmode=verify-full&sslrootcert=/certs/ca.pem&sslcert=/certs/cert.pem&sslkey=/certs/key.pk8
Environment=KC_DB_USERNAME=keycloak
Environment=KC_HTTP_ENABLED=false
Environment=KC_HTTPS_PORT=8443
Environment=KC_HTTPS_CERTIFICATE_FILE=/certs/cert.pem
Environment=KC_HTTPS_CERTIFICATE_KEY_FILE=/certs/key-pkcs8.pem
Environment=KC_HTTPS_CERTIFICATES_RELOAD_PERIOD=1h
Environment=KC_HTTPS_CLIENT_AUTH=request
Environment=KC_TRUSTSTORE_PATHS=/certs/ca.pem
Environment=KC_HOSTNAME=https://ci1.local:8443/auth
Environment=KC_HTTP_RELATIVE_PATH=/auth
Environment=KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true
Environment=KC_PROXY_HEADERS=xforwarded
Environment=KC_HEALTH_ENABLED=true
Environment=KC_BOOTSTRAP_ADMIN_USERNAME=admin
Environment=PUBLIC_URL=https://ci1.local:8443
Environment=JAVA_OPTS_KC_HEAP=-XX:MaxRAMPercentage=65 -XX:InitialRAMPercentage=30
Secret=keycloak_admin_password,type=mount,uid=1000,mode=0400
Secret=gateway_client_secret,type=mount,uid=1000,mode=0400
PodmanArgs=--entrypoint=/bin/bash
Exec=/realm/entrypoint.sh
HealthCmd=exec 3<>/dev/tcp/127.0.0.1/8443
HealthInterval=10s
PodmanArgs=--memory=900m

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
