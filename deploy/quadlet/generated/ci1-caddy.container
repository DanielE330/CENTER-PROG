# Generated by deploy/gen.py from deploy/services.yaml. Do not edit by hand.
[Unit]
Description=ci1 caddy
Requires=ci1-cert-caddy.service
After=ci1-cert-caddy.service
Requires=ci1-gateway.service
After=ci1-gateway.service
Requires=ci1-volume-init.service
After=ci1-volume-init.service

[Container]
ContainerName=caddy
Image=ghcr.io/swimshadow/ci1-web:stable
User=1000:1000
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
Tmpfs=/tmp:size=16m
Tmpfs=/config:size=4m,uid=1000,gid=1000
Volume=ci1-certs-caddy.volume:/certs:ro
Volume=%h/ci1/deploy/scripts:/agent:ro
Volume=%h/ci1/deploy/caddy/entrypoint.sh:/caddy-entrypoint.sh:ro
Volume=%h/ci1/deploy/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=ci1-caddydata.volume:/data
Network=ci1-edge.network
Network=ci1-app.network
Environment=PUBLIC_SITE=https://ci1.local:8443
Environment=XDG_DATA_HOME=/data
Environment=XDG_CONFIG_HOME=/config
PublishPort=8443:8443
PodmanArgs=--entrypoint=/bin/sh
Exec=/caddy-entrypoint.sh
PodmanArgs=--memory=96m

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
