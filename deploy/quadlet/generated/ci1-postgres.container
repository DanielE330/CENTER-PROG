# Generated by deploy/gen.py from deploy/services.yaml. Do not edit by hand.
[Unit]
Description=ci1 postgres
Requires=ci1-cert-postgres.service
After=ci1-cert-postgres.service

[Container]
ContainerName=postgres
Image=docker.io/library/postgres:16.13-bookworm
User=999:999
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
Tmpfs=/tmp:size=64m
Tmpfs=/var/run/postgresql:size=1m,uid=999,gid=999
Volume=ci1-pgdata.volume:/var/lib/postgresql/data
Volume=ci1-certs-postgres.volume:/certs:ro
Volume=%h/ci1/deploy/scripts:/agent:ro
Volume=%h/ci1/deploy/postgres/pg_hba.conf:/etc/postgresql/pg_hba.conf:ro
Volume=%h/ci1/deploy/postgres/entrypoint.sh:/etc/postgresql/entrypoint.sh:ro
Volume=%h/ci1/deploy/postgres/init.sh:/docker-entrypoint-initdb.d/10-roles.sh:ro
Network=ci1-data.network
Environment=POSTGRES_DB=ci1
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_HOST_AUTH_METHOD=trust
Environment=PGDATA=/var/lib/postgresql/data/pgdata
PodmanArgs=--entrypoint=/bin/bash
Exec=/etc/postgresql/entrypoint.sh
HealthCmd=pg_isready -h /var/run/postgresql -U postgres
HealthInterval=5s
PodmanArgs=--memory=384m

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
