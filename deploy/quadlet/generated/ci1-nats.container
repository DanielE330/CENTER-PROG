# Generated by deploy/gen.py from deploy/services.yaml. Do not edit by hand.
[Unit]
Description=ci1 nats
Requires=ci1-cert-nats.service
After=ci1-cert-nats.service
Requires=ci1-volume-init.service
After=ci1-volume-init.service

[Container]
ContainerName=nats
Image=docker.io/library/nats:2.14-alpine
User=1000:1000
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
Tmpfs=/tmp:size=64m
Volume=ci1-natsdata.volume:/data
Volume=ci1-certs-nats.volume:/certs:ro
Volume=%h/ci1/deploy/scripts:/agent:ro
Volume=%h/ci1/deploy/compose/nats.conf:/etc/nats/nats.conf:ro
Network=ci1-data.network
PodmanArgs=--entrypoint=/bin/sh
Exec=/agent/nats-entrypoint.sh
HealthCmd=wget -qO- http://127.0.0.1:8222/healthz
HealthInterval=5s
PodmanArgs=--memory=96m

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
