<file path="components/shared/DataTable.tsx">
import { useMemo, useState } from 'react'
import type { ReactNode } from 'react'
import { ArrowDown, ArrowUp, ChevronsUpDown } from 'lucide-react'
import { cn } from '../../lib/utils'

export interface Column<T> {
  key: string
  header: string
  render: (row: T) => ReactNode
  /** Provide to make the column sortable. */
  sortValue?: (row: T) => string | number
  numeric?: boolean
}

interface Props<T> {
  columns: Column<T>[]
  rows: T[]
  getRowKey: (row: T) => string
  defaultSort?: { key: string; dir: 'asc' | 'desc' }
  rowClassName?: (row: T) => string | undefined
  /** Server-side sorting: the parent owns the sort state and the order of `rows`. */
  sort?: { key: string; dir: 'asc' | 'desc' }
  onSortChange?: (key: string) => void
}

/** Table scrolls horizontally inside its own wrapper — never the page. */
export function DataTable<T>({ columns, rows, getRowKey, defaultSort, rowClassName, sort: controlled, onSortChange }: Props<T>) {
  const [local, setSort] = useState(defaultSort)
  const sort = controlled ?? local
  const sorted = useMemo(() => {
    const col = columns.find((c) => c.key === sort?.key)
    if (controlled || !col?.sortValue || !sort) return rows
    const get = col.sortValue
    const m = sort.dir === 'asc' ? 1 : -1
    return [...rows].sort((a, b) => {
      const x = get(a)
      const y = get(b)
      return (x < y ? -1 : x > y ? 1 : 0) * m
    })
  }, [rows, columns, sort, controlled])

  const toggle = (key: string) =>
    onSortChange ? onSortChange(key) : setSort((s) => (s?.key === key ? { key, dir: s.dir === 'asc' ? 'desc' : 'asc' } : { key, dir: 'asc' }))

  return (
    <div className="overflow-x-auto">
      <table className="data-table">
        <thead>
          <tr>
            {columns.map((c) => {
              const active = sort?.key === c.key
              return (
                <th key={c.key} className={cn(c.numeric && 'num')} aria-sort={active ? (sort.dir === 'asc' ? 'ascending' : 'descending') : undefined}>
                  {c.sortValue ? (
                    <button onClick={() => toggle(c.key)} className="inline-flex items-center gap-1 font-medium cursor-pointer hover:text-ink">
                      {c.header}
                      {active ? sort.dir === 'asc' ? <ArrowUp size={12} /> : <ArrowDown size={12} /> : <ChevronsUpDown size={12} />}
                    </button>
                  ) : (
                    c.header
                  )}
                </th>
              )
            })}
          </tr>
        </thead>
        <tbody>
          {sorted.map((row) => (
            <tr key={getRowKey(row)} className={rowClassName?.(row)}>
              {columns.map((c) => (
                <td key={c.key} className={cn(c.numeric && 'num tnum')}>
                  {c.render(row)}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
</file>

