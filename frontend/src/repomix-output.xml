<file path="lib/theme.ts">
import { useSyncExternalStore } from 'react'

export type Theme = 'light' | 'dark'

const KEY = 'ci.theme'
const listeners = new Set<() => void>()

/** Light is the default; only an explicit user choice (saved in localStorage) switches to dark. */
function read(): Theme {
  try {
    return localStorage.getItem(KEY) === 'dark' ? 'dark' : 'light'
  } catch {
    return 'light'
  }
}

let current: Theme = typeof document !== 'undefined' && document.documentElement.dataset.theme === 'dark' ? 'dark' : read()
if (typeof document !== 'undefined') document.documentElement.dataset.theme = current

export const getTheme = () => current

export function setTheme(next: Theme) {
  const root = document.documentElement
  root.classList.add('theme-transition')
  root.dataset.theme = next
  current = next
  try {
    localStorage.setItem(KEY, next)
  } catch {
    /* storage unavailable: theme still applies for this session */
  }
  listeners.forEach((l) => l())
  // Slightly longer than --motion-theme so the transition can finish before the class is removed.
  window.setTimeout(() => root.classList.remove('theme-transition'), 320)
}

export function useTheme(): Theme {
  return useSyncExternalStore(
    (cb) => {
      listeners.add(cb)
      return () => listeners.delete(cb)
    },
    getTheme,
  )
}
</file>

<file path="lib/utils.ts">
export function cn(...parts: Array<string | false | null | undefined>): string {
  return parts.filter(Boolean).join(' ')
}

/** Reads a design token so chart colors stay in sync with tokens.css. */
export function cssVar(name: string, fallback: string): string {
  if (typeof window === 'undefined') return fallback
  const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim()
  return v || fallback
}

export function prefersReducedMotion(): boolean {
  return typeof window !== 'undefined' && window.matchMedia('(prefers-reduced-motion: reduce)').matches
}

export const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms))
