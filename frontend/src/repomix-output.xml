import { useState } from 'react'
import type { FormEvent } from 'react'
import { useMutation } from '@tanstack/react-query'
import { useTranslation } from 'react-i18next'
import { Check, LogOut } from 'lucide-react'
import { PageContainer, PageHeader, Card } from '../../components/shared/Page'
import { DataTable } from '../../components/shared/DataTable'
import type { Column } from '../../components/shared/DataTable'
import { ErrorState, LoadingState } from '../../components/shared/States'
import { Badge } from '../../components/shared/StatusBadge'
import { Notice } from '../../components/shared/Notice'
import { LanguageSwitch } from '../../components/layout/LanguageSwitch'
import { Button } from '../../components/ui/Button'
import { Input } from '../../components/ui/Input'
import { Select } from '../../components/ui/Select'
import { useAuth, useMe } from '../../app/auth'
import { api } from '../../lib/api'
import { useImports } from '../../hooks/queries'
import { HORIZONS, loadPrefs, savePrefs } from '../../lib/prefs'
import { formatDate, formatDateTime, formatNumber } from '../../lib/formatters'
import { errorText } from '../../i18n/helpers'
import type { ImportRow } from '../../types'
import { ImportStatement } from './ImportStatement'

export default function SettingsPage() {
  const { t } = useTranslation()
  const me = useMe()
  const { setMe, logout } = useAuth()
  const imports = useImports()
  const [name, setName] = useState(me.company_name)
  const [horizon, setHorizon] = useState(() => loadPrefs().horizon)
  const [saved, setSaved] = useState(false)

  const rename = useMutation({
    mutationFn: (n: string) => api.renameCompany(n),
    onSuccess: (r) => setMe({ ...me, company_name: r.company_name }),
  })

  const submitName = (e: FormEvent) => {
    e.preventDefault()
    rename.mutate(name.trim())
  }

  const savePref = () => {
    savePrefs({ horizon })
    setSaved(true)
    setTimeout(() => setSaved(false), 2000)
  }

  const columns: Column<ImportRow>[] = [
    { key: 'file', header: t('settings.history.file'), render: (i) => <span className="font-medium break-all">{i.filename}</span> },
    {
      key: 'status', header: t('settings.history.status'),
      render: (i) => i.status === 'confirmed'
        ? <Badge tone="success">{t('settings.history.confirmed')}</Badge>
        : i.status === 'preview' ? <Badge tone="warning">{t('settings.history.preview')}</Badge> : <Badge>{i.status}</Badge>,
    },
    { key: 'period', header: t('settings.history.period'), render: (i) => (i.date_from && i.date_to ? `${formatDate(i.date_from, 'dayMonth')} — ${formatDate(i.date_to)}` : '—') },
    { key: 'rows', header: t('settings.history.rows'), numeric: true, render: (i) => (i.rows_ok == null ? '—' : formatNumber(i.rows_ok)) },
    { key: 'rejected', header: t('settings.history.rejected'), numeric: true, render: (i) => (i.errors_total ? <Badge tone="warning">{i.errors_total}</Badge> : '0') },
    { key: 'at', header: t('settings.history.uploaded'), render: (i) => <span className="whitespace-nowrap">{formatDateTime(i.created_at)}</span> },
  ]

  return (
    <PageContainer>
      <PageHeader
        title={t('settings.title')}
        description={t('settings.description')}
        actions={<Button onClick={() => void logout()}><LogOut size={16} aria-hidden /> {t('auth.logout')}</Button>}
      />

      <div className="grid gap-5 lg:grid-cols-2">
        <div className="flex flex-col gap-5">
          <Card title={t('settings.language.title')} subtitle={t('settings.language.subtitle')}>
            <div className="px-5 pb-5"><LanguageSwitch /></div>
          </Card>

          <Card title={t('settings.org.title')} subtitle={t('settings.org.subtitle')}>
            <form className="px-5 pb-5 flex flex-col gap-4" onSubmit={submitName}>
              <Input label={t('settings.org.name')} value={name} onChange={(e) => { setName(e.target.value); rename.reset() }} required minLength={2} maxLength={200} />
              <Input label={t('settings.org.email')} value={me.email} readOnly />
              <Input label={t('settings.org.id')} value={me.company_id} readOnly className="tnum" />
              <Select label={t('settings.org.currency')} disabled onChange={() => {}} hint={t('settings.org.currencyHint')} value="RUB" options={[{ value: 'RUB', label: t('settings.org.rub') }]} />
              {rename.isSuccess && <Notice tone="success">{t('settings.org.saved')}</Notice>}
              {rename.isError && <Notice tone="danger">{errorText(t, rename.error)}</Notice>}
              <div>
                <Button type="submit" variant="primary" disabled={rename.isPending || name.trim() === me.company_name || name.trim().length < 2}>
                  {rename.isPending ? t('common.saving') : t('common.save')}
                </Button>
              </div>
            </form>
          </Card>

          <Card title={t('settings.prefs.title')} subtitle={t('settings.prefs.subtitle')}>
            <div className="px-5 pb-5 flex flex-col gap-4">
              <Select
                label={t('settings.prefs.horizon')}
                hint={t('settings.prefs.horizonHint')}
                value={horizon}
                onChange={(v) => { setHorizon(Number(v)); setSaved(false) }}
                options={HORIZONS.map((d) => ({ value: d, label: t('common.daysCount', { count: d }) }))}
              />
              <div className="flex items-center gap-3">
                <Button variant="primary" onClick={savePref}>{t('common.save')}</Button>
                {saved && (
                  <span className="inline-flex items-center gap-1 text-sm text-primary" role="status">
                    <Check size={16} aria-hidden /> {t('common.saved')}
                  </span>
                )}
              </div>
            </div>
          </Card>
        </div>

        <Card title={t('import.title')} subtitle={t('import.subtitle')}>
          <div className="px-5 pb-5"><ImportStatement /></div>
        </Card>
      </div>

      <Card title={t('settings.history.title')}>
        {imports.isPending && <LoadingState height={100} />}
        {imports.isError && <ErrorState message={errorText(t, imports.error)} onRetry={() => void imports.refetch()} />}
        {imports.data && (imports.data.items.length === 0
          ? <p className="px-5 pb-5 text-sm text-muted">{t('settings.history.empty')}</p>
          : <DataTable columns={columns} rows={imports.data.items} getRowKey={(i) => i.import_id} />)}
      </Card>
    </PageContainer>
  )
}
</file>

<file path="features/transactions/TransactionsPage.tsx">
import { useEffect, useState } from 'react'
import { useTranslation } from 'react-i18next'
import { ArrowDownLeft, ArrowUpRight, ChevronLeft, ChevronRight, FileUp, Receipt } from 'lucide-react'
import { Link } from 'react-router-dom'
import { PageContainer, PageHeader, Card } from '../../components/shared/Page'
import { DataTable } from '../../components/shared/DataTable'
import type { Column } from '../../components/shared/DataTable'
import { EmptyState, ErrorState, LoadingState } from '../../components/shared/States'
import { CategoryStatusBadge } from '../../components/shared/StatusBadge'
import { Notice } from '../../components/shared/Notice'
import { Button } from '../../components/ui/Button'
import { Input } from '../../components/ui/Input'
import { Select } from '../../components/ui/Select'
import { useSetCategory, useTransactions } from '../../hooks/queries'
import { formatDate, formatKop, formatNumber } from '../../lib/formatters'
import { errorText } from '../../i18n/helpers'
import { CATEGORIES, categoryLabel } from '../../i18n/categories'
import type { Transaction } from '../../types'

const LIMIT = 50
type SortKey = 'date' | 'amount' | 'counterparty' | 'category'
const sortable = () => 0

export default function TransactionsPage() {
  const { t } = useTranslation()
  const [dir, setDir] = useState<'' | 'in' | 'out'>('')
  const [category, setCategory] = useState('')
  const [search, setSearch] = useState('')
  const [q, setQ] = useState('')
  const [sort, setSort] = useState<{ key: SortKey; dir: 'asc' | 'desc' }>({ key: 'date', dir: 'desc' })
  const [offset, setOffset] = useState(0)

  // Search is debounced: one request after the user stops typing.
  useEffect(() => {
    const id = window.setTimeout(() => {
      setOffset(0)
      setQ(search.trim())
    }, 300)
    return () => window.clearTimeout(id)
  }, [search])

  const query = useTransactions({ limit: LIMIT, offset, category, direction: dir, q, sort: sort.key, order: sort.dir })
  const setCat = useSetCategory()
  const data = query.data
  const filtered = category !== '' || dir !== '' || q !== ''

  const toggleSort = (key: string) => {
    setOffset(0)
    setSort((s) => (s.key === key ? { key: s.key, dir: s.dir === 'asc' ? 'desc' : 'asc' } : { key: key as SortKey, dir: key === 'counterparty' || key === 'category' ? 'asc' : 'desc' }))
  }

  const columns: Column<Transaction>[] = [
    { key: 'date', header: t('transactions.col.date'), sortValue: sortable, render: (x) => <span className="whitespace-nowrap">{formatDate(x.date)}</span> },
    {
      key: 'counterparty', header: t('transactions.col.counterparty'), sortValue: sortable,
      render: (x) => (
        <div className="min-w-[220px] max-w-[460px]">
          <p className="font-medium">{x.counterparty || '—'}</p>
          <p className="text-xs text-muted">{x.purpose}</p>
        </div>
      ),
    },
    {
      key: 'direction', header: t('transactions.col.direction'),
      render: (x) => x.amount_kop.startsWith('-')
        ? <span className="inline-flex items-center gap-1 text-warning"><ArrowUpRight size={14} aria-hidden /> {t('transactions.outgoing')}</span>
        : <span className="inline-flex items-center gap-1 text-primary"><ArrowDownLeft size={14} aria-hidden /> {t('transactions.incoming')}</span>,
    },
    {
      key: 'category', header: t('transactions.col.category'), sortValue: sortable,
      render: (x) => (
        <div className="w-[190px]">
          <Select
            aria-label={t('transactions.categoryOf', { name: x.counterparty || x.purpose.slice(0, 40) })}
            value={x.category}
            disabled={setCat.isPending && setCat.variables?.id === x.id}
            onChange={(c) => setCat.mutate({ id: x.id, category: c })}
            options={[...(CATEGORIES as readonly string[]).includes(x.category) ? [] : [{ value: x.category, label: x.category }], ...CATEGORIES.map((c) => ({ value: c, label: categoryLabel(t, c) }))]}
          />
        </div>
      ),
    },
    { key: 'status', header: t('transactions.col.status'), render: (x) => <CategoryStatusBadge tx={x} /> },
    {
      key: 'amount', header: t('transactions.col.amount'), numeric: true, sortValue: sortable,
      render: (x) => <span className={x.amount_kop.startsWith('-') ? 'font-semibold' : 'text-primary font-semibold'}>{formatKop(x.amount_kop, { sign: true })}</span>,
    },
  ]

  return (
    <PageContainer>
      <PageHeader
        title={t('transactions.title')}
        description={data ? t('transactions.descriptionCount', { count: data.total, formatted: formatNumber(data.total) }) : t('transactions.description')}
      />
      {setCat.isError && <Notice tone="danger">{errorText(t, setCat.error)}</Notice>}
      <Card>
        <div className="grid gap-3 p-4 sm:grid-cols-[1fr_180px_220px_auto] items-end">
          <Input aria-label={t('common.search')} type="search" placeholder={t('transactions.searchPlaceholder')} value={search} onChange={(e) => setSearch(e.target.value)} />
          <Select
            aria-label={t('transactions.col.direction')}
            value={dir}
            onChange={(v) => { setOffset(0); setDir(v as '' | 'in' | 'out') }}
            options={[{ value: '', label: t('transactions.allDirections') }, { value: 'in', label: t('transactions.incomingPlural') }, { value: 'out', label: t('transactions.outgoingPlural') }]}
          />
          <Select
            aria-label={t('transactions.col.category')}
            value={category}
            onChange={(v) => { setOffset(0); setCategory(v) }}
            options={[{ value: '', label: t('transactions.allCategories') }, ...CATEGORIES.map((c) => ({ value: c, label: categoryLabel(t, c) }))]}
          />
          {filtered && (
            <Button variant="ghost" onClick={() => { setSearch(''); setQ(''); setCategory(''); setDir(''); setOffset(0) }}>{t('common.reset')}</Button>
          )}
        </div>

        {query.isPending && <LoadingState />}
        {query.isError && <ErrorState message={errorText(t, query.error)} onRetry={() => void query.refetch()} />}
        {data && data.items.length === 0 && (
          <EmptyState
            icon={<Receipt size={22} aria-hidden />}
            title={filtered ? t('common.nothingFound') : t('transactions.emptyTitle')}
            description={filtered ? t('common.changeFilters') : t('transactions.emptyText')}
            action={!filtered && <Link to="/settings"><Button variant="primary"><FileUp size={16} aria-hidden /> {t('dashboard.import')}</Button></Link>}
          />
        )}
        {data && data.items.length > 0 && (
          <div className={query.isFetching ? 'opacity-60 transition-opacity' : 'transition-opacity'} aria-busy={query.isFetching}>
            <DataTable columns={columns} rows={data.items} getRowKey={(x) => String(x.id)} sort={sort} onSortChange={toggleSort} />
          </div>
        )}
        {data && data.total > LIMIT && (
          <nav className="flex items-center justify-between gap-3 px-4 py-3 border-t border-line" aria-label={t('transactions.pagination')}>
            <Button size="sm" disabled={offset === 0} onClick={() => setOffset(Math.max(0, offset - LIMIT))}>
              <ChevronLeft size={14} aria-hidden /> {t('common.back')}
            </Button>
            <span className="text-xs text-muted tnum" aria-live="polite">
              {t('transactions.range', { from: offset + 1, to: Math.min(offset + LIMIT, data.total), total: formatNumber(data.total) })}
            </span>
            <Button size="sm" disabled={offset + LIMIT >= data.total} onClick={() => setOffset(offset + LIMIT)}>
              {t('common.next')} <ChevronRight size={14} aria-hidden />
            </Button>
          </nav>
        )}
      </Card>
    </PageContainer>
  )
}
</file>

<file path="hooks/queries.ts">
import { useMemo } from 'react'
import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query'
import { api } from '../lib/api'
import type { TransactionQuery } from '../lib/api'
import { useAuth } from '../app/auth'
import { buildView } from '../features/forecast/model'
import type { ForecastView } from '../features/forecast/model'
import type { NewExpectedEvent, ScenarioParams } from '../types'

/** All company data lives under ['co', companyId, ...], so one call refreshes everything after a data change. */
function useKey() {
  const { me } = useAuth()
  const cid = me?.company_id ?? ''
  return (...k: unknown[]) => ['co', cid, ...k] as const
}

export function useInvalidateAll() {
  const qc = useQueryClient()
  return () => qc.invalidateQueries({ queryKey: ['co'] })
}

/** The latest base forecast; the server recomputes it by itself when data changed (`recomputed`). */
export function useForecastRun() {
  const key = useKey()
  return useQuery({ queryKey: key('forecast'), queryFn: api.latestForecast })
}

/** Forecast plus display-only derived data. `data` is null when no forecast exists yet. */
export function useForecast() {
  const q = useForecastRun()
  const view = useMemo<ForecastView | null>(() => (q.data ? buildView(q.data) : null), [q.data])
  return { ...q, view }
}

export function useRecalc() {
  const key = useKey()
  const qc = useQueryClient()
  const all = useInvalidateAll()
  return useMutation({
    mutationFn: (horizonDays: number) => api.createForecast(horizonDays),
    onSuccess: (run) => {
      qc.setQueryData(key('forecast'), { ...run, recomputed: false })
      void all()
    },
  })
}

export function useScenario() {
  return useMutation({ mutationFn: (v: { horizon: number; params: ScenarioParams }) => api.scenario(v.horizon, v.params) })
}

export function useBacktest(enabled: boolean) {
  const key = useKey()
  return useQuery({ queryKey: key('backtest'), queryFn: api.backtest, enabled, staleTime: 5 * 60_000 })
}

export function useTransactions(q: TransactionQuery) {
  const key = useKey()
  return useQuery({ queryKey: key('transactions', q), queryFn: () => api.transactions(q), placeholderData: (prev) => prev })
}

export function useSetCategory() {
  const all = useInvalidateAll()
  return useMutation({ mutationFn: (v: { id: number; category: string }) => api.setCategory(v.id, v.category), onSuccess: () => void all() })
}

export function useExpectedEvents() {
  const key = useKey()
  return useQuery({ queryKey: key('events'), queryFn: api.expectedEvents })
}

export function useCreateEvent() {
  const all = useInvalidateAll()
  return useMutation({ mutationFn: (e: NewExpectedEvent) => api.createEvent(e), onSuccess: () => void all() })
}

export function useDeleteEvent() {
  const all = useInvalidateAll()
  return useMutation({ mutationFn: (id: string) => api.deleteEvent(id), onSuccess: () => void all() })
}

export function useTaxCalendar() {
  const all = useInvalidateAll()
  return useMutation({ mutationFn: (amountKop?: string) => api.taxCalendar(amountKop), onSuccess: () => void all() })
}

export function useSyncIntegrations() {
  const all = useInvalidateAll()
  return useMutation({ mutationFn: (ext: string) => api.syncIntegrations(ext), onSuccess: () => void all() })
}

export function usePlanFact(days: number) {
  const key = useKey()
  return useQuery({ queryKey: key('plan-fact', days), queryFn: () => api.planFact(days) })
}

export function useImports() {
  const key = useKey()
  return useQuery({ queryKey: key('imports'), queryFn: api.imports })
}

export function useUploadStatement() {
  return useMutation({ mutationFn: (file: File) => api.uploadStatement(file) })
}

export function useConfirmImport() {
  const all = useInvalidateAll()
  return useMutation({ mutationFn: (id: string) => api.confirmImport(id), onSuccess: () => void all() })
}

export function useKeyRate() {
  const key = useKey()
  return useQuery({ queryKey: key('key-rate'), queryFn: api.keyRate, staleTime: 60 * 60_000 })
}
