# Generated by deploy/gen.py from deploy/services.yaml. Do not edit by hand.
[Unit]
Description=ci1 gateway
Requires=ci1-cert-gateway.service
After=ci1-cert-gateway.service
Requires=ci1-nats.service
After=ci1-nats.service
Requires=ci1-keycloak.service
After=ci1-keycloak.service

[Container]
ContainerName=gateway
Image=ghcr.io/swimshadow/ci1-gateway:stable
User=65532:65532
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
Tmpfs=/tmp:size=64m
Volume=ci1-certs-gateway.volume:/certs:ro
Network=ci1-app.network
Network=ci1-data.network
Environment=SERVICE_NAME=gateway
Environment=LISTEN_ADDR=0.0.0.0:8443
Environment=CERT_DIR=/certs
Environment=ALLOWED_CLIENTS=caddy
Environment=OIDC_ISSUER=https://ci1.local:8443/auth/realms/ci1
Environment=OIDC_JWKS_URL=https://keycloak:8443/auth/realms/ci1/protocol/openid-connect/certs
Environment=OIDC_AUDIENCE=ci1-api
Environment=KEYCLOAK_INTERNAL_URL=https://keycloak:8443/auth
Environment=NATS_URL=tls://nats:4222
Environment=RUST_LOG=info
Environment=PUBLIC_URL=https://ci1.local:8443
Secret=session_key,type=mount,uid=65532,mode=0400
Secret=gateway_client_secret,type=mount,uid=65532,mode=0400
HealthCmd=/app/service --healthcheck
HealthInterval=10s
PodmanArgs=--memory=96m

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
