# Generated by deploy/gen.py from deploy/services.yaml. Do not edit by hand.
[Unit]
Description=ci1 volume-init

[Container]
ContainerName=volume-init
Image=docker.io/library/busybox:1.37.0
User=0:0
DropCapability=all
AddCapability=CHOWN
AddCapability=DAC_OVERRIDE
AddCapability=FOWNER
NoNewPrivileges=true
Volume=ci1-natsdata.volume:/nats
Volume=ci1-caddydata.volume:/caddy
Exec=sh -c chown -R 1000:1000 /nats /caddy

[Service]
Restart=no
TimeoutStartSec=300

[Install]
WantedBy=default.target
