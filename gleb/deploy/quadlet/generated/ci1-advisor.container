# Generated by deploy/gen.py from deploy/services.yaml. Do not edit by hand.
[Unit]
Description=ci1 advisor
Requires=ci1-cert-advisor.service
After=ci1-cert-advisor.service
Requires=ci1-nats.service
After=ci1-nats.service
Requires=ci1-keycloak.service
After=ci1-keycloak.service

[Container]
ContainerName=advisor
Image=ghcr.io/swimshadow/ci1-advisor:stable
User=10001:10001
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
Tmpfs=/tmp:size=256m,uid=10001,gid=10001
Volume=ci1-certs-advisor.volume:/certs:ro
Network=ci1-app.network
Environment=SERVICE_NAME=advisor
Environment=LISTEN_ADDR=0.0.0.0:8443
Environment=CERT_DIR=/certs
Environment=ALLOWED_CLIENTS=gateway
Environment=OIDC_ISSUER=https://ci1.local:8443/auth/realms/ci1
Environment=OIDC_JWKS_URL=https://keycloak:8443/auth/realms/ci1/protocol/openid-connect/certs
Environment=OIDC_AUDIENCE=ci1-api
Environment=KEYCLOAK_INTERNAL_URL=https://keycloak:8443/auth
Environment=NATS_URL=tls://nats:4222
Environment=RUST_LOG=info
Environment=AGENT_RUNTIME=hermes
Environment=HERMES_HOME=/tmp/hermes
HealthCmd=/venv/bin/python -m advisor --healthcheck
HealthInterval=10s
PodmanArgs=--memory=512m

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
