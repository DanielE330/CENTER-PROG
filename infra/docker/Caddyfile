# Gateway: единственная публичная точка входа. TLS, SPA, reverse proxy на api.
# SITE_ADDRESS=:3000 (http, стенд) или example.com (автоматический TLS; тогда CADDY_AUTO_HTTPS=on и COOKIE_SECURE=true).
{
	admin off
	auto_https {$CADDY_AUTO_HTTPS:off}
}

{$SITE_ADDRESS::3000} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self' chrome-extension:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000" # действует только по HTTPS
		-Server
	}

	# служебный контур наружу не отдаём
	@internal path /internal/* /metrics /metrics/*
	respond @internal 404

	handle /api/* {
		request_body {
			max_size 26MB
		}
		reverse_proxy web-api:3000 {
			transport http {
				response_header_timeout 90s
			}
		}
	}

	handle /live {
		reverse_proxy web-api:3000
	}

	# хэшированные ассеты: неизменяемы; отсутствующий файл — честный 404, а не index.html (иначе устаревший
	# клиент получает HTML вместо модуля и падает с «error loading dynamically imported module»)
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
