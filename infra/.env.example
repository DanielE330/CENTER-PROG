# Скопируйте в infra/.env и при необходимости измените.
GATEWAY_PORT=3000          # порт сайта на хосте
SITE_ADDRESS=:3000         # :3000 (http) или example.com (автоматический HTTPS)
CADDY_AUTO_HTTPS=off       # on при публикации на домене
COOKIE_SECURE=false        # true при работе по HTTPS
DEMO_SEED=1                # 0 — не создавать demo@example.com
MOCK_TODAY=2026-09-29      # «сегодня» для имитаторов 1С/ЭДО/банка и интегратора
DATASET_DIR=../data/demo   # ../data/dataset — полный датасет, если он скачан
DEMO_FEED_ENABLED=1        # демо «Прошла неделя» для demo@example.com (по умолчанию как DEMO_SEED)
DEMO_CUTOFF=2026-07-12     # демо-пользователь получает выписку C001 до этой даты, остальное отдаёт demo_feed
DEMO_COMPANY=C001          # компания датасета для ленты демо
# --- Консультант с ИИ (сервис llm-gateway). Ключей в репозитории нет: задайте их здесь (файл infra/.env не коммитится) или в окружении.
LLM_PROVIDER=              # anthropic | openai | gemini | openrouter; пусто — консультант отвечает шаблоном из прогноза
LLM_MODEL=                 # пусто — модель по умолчанию провайдера (рекомендуется задать явно)
LLM_DAILY_TOKEN_BUDGET=200000  # токенов на пользователя в сутки (UTC); 0 — без ограничения
LLM_TIMEOUT_SECONDS=60     # таймаут одного обращения к провайдеру
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# --- Панель оператора платформы (сервис backoffice, страница /operator). Файл infra/.env не коммитится: пароль храните только здесь.
OPERATOR_EMAIL=            # email первого оператора; создаётся при старте backoffice, если такого оператора ещё нет
OPERATOR_PASSWORD=         # пароль первого оператора, от 12 символов; после создания можно убрать из файла
BACKOFFICE_REQUIRE_2FA=1   # второй фактор оператора (TOTP, QR при первом входе + резервные коды) обязателен; 0 — только для локальной отладки
BACKOFFICE_MFA_KEY=        # ключ шифрования секретов 2FA операторов (install.sh генерирует); пусто — ключ-файл в томе backoffice-data
# --- Telegram-бот и консультант Hermes (сервис notifier). Токен бота — только здесь или в окружении, в репозиторий не попадает.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
HERMES_URL=                # OpenAI-совместимый сервер модели; пусто — отчёты по правилам
HERMES_API_KEY=
AUTH_MFA_KEY=              # ключ шифрования секретов 2FA пользователей компаний
AUTH_REQUIRE_2FA=0         # 1 — второй фактор обязателен всем, кто входит по паролю
# --- Почта (сервис notify). По умолчанию письма ловит Mailpit: http://localhost:8025 (только с этой машины).
PUBLIC_URL=http://localhost:3000   # адрес сайта для ссылок в письмах
MAILPIT_PORT=8025          # порт веб-интерфейса Mailpit на 127.0.0.1
# Реальная отправка: задайте SMTP-сервер. Пример для Яндекс 360 (пароль приложения, не пароль от почты):
#   SMTP_HOST=smtp.yandex.ru  SMTP_PORT=465  SMTP_SECURITY=ssl  SMTP_USER=noreply@example.ru  SMTP_PASSWORD=<пароль приложения>
#   MAIL_FROM=Центр Прогнозирования <noreply@example.ru>
SMTP_HOST=                 # пусто — Mailpit
SMTP_PORT=                 # 465 (ssl) или 587 (starttls); пусто — 1025 для Mailpit
SMTP_SECURITY=             # none | starttls | ssl
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
