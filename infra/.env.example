# Скопируйте в infra/.env и при необходимости измените.
GATEWAY_PORT=3000          # порт сайта на хосте
SITE_ADDRESS=:3000         # :3000 (http) или example.com (автоматический HTTPS)
CADDY_AUTO_HTTPS=off       # on при публикации на домене
COOKIE_SECURE=false        # true при работе по HTTPS
DEMO_SEED=1                # 0 — не создавать demo@example.com
MOCK_TODAY=2026-09-29      # «сегодня» для имитаторов 1С/ЭДО/банка и интегратора
DATASET_DIR=../data/demo   # ../data/dataset — полный датасет, если он скачан
