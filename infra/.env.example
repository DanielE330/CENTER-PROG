# Скопируйте в infra/.env и при необходимости измените.
GATEWAY_PORT=3000          # порт сайта на хосте
SITE_ADDRESS=:3000         # :3000 (http) или example.com (автоматический HTTPS)
CADDY_AUTO_HTTPS=off       # on при публикации на домене
COOKIE_SECURE=false        # true при работе по HTTPS
DEMO_SEED=1                # 0 — не создавать demo@example.com
MOCK_TODAY=2026-09-29      # «сегодня» для имитаторов 1С/ЭДО/банка и интегратора
DATASET_DIR=../data/demo   # ../data/dataset — полный датасет, если он скачан
DEMO_FEED_ENABLED=1        # демо «Прошла неделя» для demo@example.com (по умолчанию как DEMO_SEED)
DEMO_CUTOFF=2026-07-12     # демо-пользователь получает выписку C001 до этой даты, остальное отдаёт demo_feed
DEMO_COMPANY=C001          # компания датасета для ленты демо
# --- Консультант с ИИ (сервис llm-gateway). Ключей в репозитории нет: задайте их здесь (файл infra/.env не коммитится) или в окружении.
LLM_PROVIDER=              # anthropic | openai | gemini | openrouter; пусто — консультант отвечает шаблоном из прогноза
LLM_MODEL=                 # пусто — модель по умолчанию провайдера (рекомендуется задать явно)
LLM_DAILY_TOKEN_BUDGET=200000  # токенов на пользователя в сутки (UTC); 0 — без ограничения
LLM_TIMEOUT_SECONDS=60     # таймаут одного обращения к провайдеру
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
