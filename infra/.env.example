# Скопируйте в infra/.env и при необходимости измените.
# порт сайта на хосте
GATEWAY_PORT=3000
# :3000 (http) или example.com (автоматический HTTPS)
SITE_ADDRESS=:3000
# on при публикации на домене
CADDY_AUTO_HTTPS=off
# true при работе по HTTPS
COOKIE_SECURE=false
# 0 — не создавать demo@example.com
DEMO_SEED=1
# «сегодня» для имитаторов 1С/ЭДО/банка и интегратора
MOCK_TODAY=2026-09-29
# ../data/dataset — полный датасет, если он скачан
DATASET_DIR=../data/demo
# демо «Прошла неделя» для demo@example.com (по умолчанию как DEMO_SEED)
DEMO_FEED_ENABLED=1
# демо-пользователь получает выписку C001 до этой даты, остальное отдаёт demo_feed
DEMO_CUTOFF=2026-07-12
# компания датасета для ленты демо
DEMO_COMPANY=C001
# --- Тестовый вход: кнопки «Директор / Редактор / Наблюдатель» на странице входа (демо-аккаунты demo@example.com,
# demo-editor@example.com, demo-viewer@example.com создаёт seed_demo.sh). Пустое значение — как DEMO_SEED, 0 — кнопок нет.
# НА ПУБЛИЧНОМ СЕРВЕРЕ С НАСТОЯЩИМИ ДАННЫМИ поставьте 0 (и DEMO_SEED=0): любой посетитель войдёт без пароля.
DEMO_LOGIN=
# Пароль демо-аккаунтов (min 8 символов); подставляет сервер, в ответах и логах его нет. Пусто — demo12345.
DEMO_PASSWORD=
# --- Сведения ФНС (сервис fns): налоги на год, ЕНС из справки, проверка контрагентов по открытым реестрам (docs/fns.md).
# Что проверять и что считать риском, настраивает каждая компания в «Настройки → Сведения ФНС».
# контакт в User-Agent запросов к реестрам (ссылка на проект или ваша почта)
FNS_CONTACT=https://github.com/DanielE330/CI-hack
# не чаще одного запроса к одному сайту за столько секунд
FNS_MIN_INTERVAL=1.0
# срок жизни кэша проверок контрагентов, секунд (сутки)
FNS_CACHE_TTL=86400
# --- ИИ-консультант на Hermes Agent (docs/advisor-hermes.md): модель по подписке ChatGPT/Codex, инструменты компании по MCP.
# Включение: задать оба ключа (любые длинные случайные строки, `openssl rand -hex 24`), один раз войти в подписку
# `docker compose -f infra/docker-compose.yml --profile hermes run --rm hermes-login` и поднять `--profile hermes up -d`.
# Пусто — консультант работает через llm-gateway (ниже) или шаблоном из прогноза.
HERMES_AGENT_KEY=
ADVISOR_MCP_TOKEN=
# модель подписки: список зависит от аккаунта ChatGPT (docs/advisor-hermes.md), например gpt-6.1-sol, gpt-5.6-terra
HERMES_AGENT_MODEL=gpt-6.1-sol
# где Hermes хранит вход в подписку (auth.json); по умолчанию — том hermes-data
HERMES_DATA=
# --- Консультант с ИИ (сервис llm-gateway). Ключей в репозитории нет: задайте их здесь (файл infra/.env не коммитится) или в окружении.
# anthropic | openai | gemini | openrouter; пусто — консультант отвечает шаблоном из прогноза
LLM_PROVIDER=
# пусто — модель по умолчанию провайдера (рекомендуется задать явно)
LLM_MODEL=
# токенов на пользователя в сутки (UTC); 0 — без ограничения
LLM_DAILY_TOKEN_BUDGET=200000
# таймаут одного обращения к провайдеру
LLM_TIMEOUT_SECONDS=60
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# --- Панель оператора платформы (сервис backoffice, страница /operator). Файл infra/.env не коммитится: пароль храните только здесь.
# email первого оператора; создаётся при старте backoffice, если такого оператора ещё нет
OPERATOR_EMAIL=
# пароль первого оператора, от 12 символов; после создания можно убрать из файла
OPERATOR_PASSWORD=
# второй фактор оператора (TOTP, QR при первом входе + резервные коды) обязателен; 0 — только для локальной отладки
BACKOFFICE_REQUIRE_2FA=1
# ключ шифрования секретов 2FA операторов (install.sh генерирует); пусто — ключ-файл в томе backoffice-data
BACKOFFICE_MFA_KEY=
# --- Telegram-бот и консультант Hermes (сервис notifier). Токен бота — только здесь или в окружении, в репозиторий не попадает.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# OpenAI-совместимый сервер модели; пусто — отчёты по правилам
HERMES_URL=
HERMES_API_KEY=
# ключ шифрования секретов 2FA пользователей компаний
AUTH_MFA_KEY=
# 1 — второй фактор обязателен всем, кто входит по паролю
AUTH_REQUIRE_2FA=0
# --- Почта (сервис notify). По умолчанию письма ловит Mailpit: http://localhost:8025 (только с этой машины).
# Комментарии в этом блоке стоят на отдельных строках: Docker Compose читает «KEY=   # текст» как значение «# текст».
# Адрес сайта для ссылок в письмах:
PUBLIC_URL=http://localhost:3000
# Порт веб-интерфейса Mailpit на 127.0.0.1:
MAILPIT_PORT=8025
# Реальная отправка: задайте SMTP-сервер. Пример для Яндекс 360 (пароль приложения, не пароль от почты):
#   SMTP_HOST=smtp.yandex.ru  SMTP_PORT=465  SMTP_SECURITY=ssl  SMTP_USER=noreply@example.ru  SMTP_PASSWORD=<пароль приложения>
# Пароль с $ или # берите в одинарные кавычки: SMTP_PASSWORD='pa$s#word'. Подробности и разбор ошибок: docs/mail.md.
# SMTP_HOST пуст — Mailpit.
SMTP_HOST=
# 465 (ssl) или 587 (starttls); пусто — 587 для своего хоста, 1025 для Mailpit.
SMTP_PORT=
# none | starttls | ssl; пусто — по порту (465 ssl, 587 starttls).
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
# Пусто — адрес SMTP_USER (провайдеры принимают только свой адрес отправителя). Иначе: Центр Прогнозирования <noreply@example.ru>
MAIL_FROM=
# Необязательно: полное имя хоста для EHLO (mail.example.ru).
SMTP_HELO=
# 0 — не проверять сертификат; только для своего сервера с самоподписанным сертификатом.
SMTP_TLS_VERIFY=1
# Проверка без отправки письма: docker compose -f infra/docker-compose.yml exec notify python -m notify.check [--to me@example.ru]

# --- 1С. Пусто — имитатор 1С (onec). Настоящая база, например 1С:Фреш: адрес приложения без кода языка,
# пользователь стандартного интерфейса OData (Администрирование → Синхронизация данных → Настройки OData).
#   ONEC_URL=https://msk1.1cfresh.com/a/ea/<номер области>  ONEC_USER=odata  ONEC_PASSWORD=<пароль>
ONEC_URL=
ONEC_USER=
ONEC_PASSWORD=
# дата «сегодня» для просрочки счетов из 1С; пусто — MOCK_TODAY (демо-выписка заканчивается 29.09)
INTEGRATOR_TODAY=
